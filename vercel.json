{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "redirects": [
    { "source": "/execpad", "destination": "/agentpad", "permanent": true },
    { "source": "/ghost-env", "destination": "/stubfetch", "permanent": true },
    { "source": "/runmix", "destination": "/agentpad", "permanent": true },
    { "source": "/docs/runmix", "destination": "/docs/agentpad", "permanent": true },
    { "source": "/docs/runmix/:path*", "destination": "/docs/agentpad/:path*", "permanent": true },
    { "source": "/slaprun", "destination": "/agentpad", "permanent": true },
    { "source": "/docs/slaprun", "destination": "/docs/agentpad", "permanent": true },
    { "source": "/docs/slaprun/:path*", "destination": "/docs/agentpad/:path*", "permanent": true }
  ]
}
