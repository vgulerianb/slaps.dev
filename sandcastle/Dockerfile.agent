# syntax=docker/dockerfile:1
FROM rust:1.83-bookworm AS builder
WORKDIR /app
COPY Cargo.toml ./
COPY core ./core
COPY agent ./agent
RUN cargo build --release -p sandcastle-agent

FROM node:20-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip ca-certificates bash curl git jq sqlite3 \
    && rm -rf /var/lib/apt/lists/*
RUN ln -sf python3 /usr/bin/python
COPY --from=builder /app/target/release/sandcastle-agent /usr/local/bin/sandcastle-agent
ENV SANDCASTLE_DATA_DIR=/data
EXPOSE 9797
VOLUME ["/data"]
CMD ["sandcastle-agent"]
